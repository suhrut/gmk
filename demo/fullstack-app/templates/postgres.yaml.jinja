---
# Postgres credentials. NOTE: this demo uses a hard-coded password
# embedded in the manifest. A production setup should source these
# from a sealed-secret or external-secrets operator.
apiVersion: v1
kind: Secret
metadata:
  name: postgres-credentials
  namespace: {{ namespace }}
type: Opaque
stringData:
  POSTGRES_USER: "{{ db_user }}"
  POSTGRES_PASSWORD: "apppass"
  POSTGRES_DB: "{{ db_name }}"

---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: postgres-data
  namespace: {{ namespace }}
spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: {{ pvc_size }}

---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: {{ name }}
  namespace: {{ namespace }}
spec:
  serviceName: {{ name }}
  replicas: 1
  selector:
    matchLabels:
      app: {{ name }}
  template:
    metadata:
      labels:
        app: {{ name }}
    spec:
      containers:
        - name: postgres
          image: {{ image }}
          ports:
            - containerPort: {{ port }}
              name: postgres
          envFrom:
            - secretRef:
                name: postgres-credentials
          volumeMounts:
            - name: data
              mountPath: /var/lib/postgresql/data
              subPath: pgdata
          readinessProbe:
            exec:
              command: [pg_isready, -U, "{{ db_user }}", -d, "{{ db_name }}"]
            initialDelaySeconds: 5
            periodSeconds: 5
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: postgres-data

---
apiVersion: v1
kind: Service
metadata:
  name: {{ name }}
  namespace: {{ namespace }}
spec:
  selector:
    app: {{ name }}
  ports:
    - port: {{ port }}
      targetPort: {{ port }}
      name: postgres
  clusterIP: None
