#!/usr/bin/env bash
# install.sh — bundled into the OCI artifact for prod-host deployment.
#
# This script runs on the production host AFTER `oras pull` + tar
# extraction. It expects the working directory to contain:
#
#   manifests/      — k8s YAML to apply
#   pki/ca.crt      — CA cert to trust (so the host can talk to Zot
#                     if TLS is enabled in a future iteration)
#   pki/server.crt  — server cert for the ingress
#
# It does NOT clone any git repository — everything needed is in
# this directory.
#
# Generated by gmk at bundle time from: templates/install.sh.jinja
# Project: {{ project }}, version: {{ version }}, namespace: {{ namespace }}

set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
cd "$here"

echo "==> {{ project }} {{ version }} install"
echo "    namespace: {{ namespace }}"
echo "    bundle:    $here"
echo

# 1. Sanity checks.
for tool in kubectl; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "FATAL: $tool not found in PATH" >&2
    exit 1
  fi
done

# 2. Optionally trust the CA. We don't sudo from inside a bundle —
#    just print the command for the operator to run.
if [ -f "$here/pki/ca.crt" ]; then
  echo "==> CA cert available at: $here/pki/ca.crt"
  echo "    To trust it system-wide on this host, run as root:"
  echo "       sudo cp $here/pki/ca.crt /usr/local/share/ca-certificates/{{ project }}-ca.crt"
  echo "       sudo update-ca-certificates"
  echo
fi

# 3. Apply manifests in lexical order (filenames have 00-, 10-, 90-
#    prefixes to control ordering: namespace first, then DB, then apps,
#    then ingress).
if [ ! -d "$here/manifests" ]; then
  echo "FATAL: $here/manifests not found" >&2
  exit 1
fi

echo "==> applying manifests"
kubectl apply -f "$here/manifests"

echo
echo "==> rollout"
# Wait for the namespace's main workloads.
kubectl -n {{ namespace }} rollout status statefulset/postgres --timeout=120s || true
kubectl -n {{ namespace }} rollout status deployment/backend   --timeout=120s || true
kubectl -n {{ namespace }} rollout status deployment/frontend  --timeout=120s || true

echo
echo "==> status"
kubectl -n {{ namespace }} get pods
echo
kubectl -n {{ namespace }} get svc
echo
kubectl -n {{ namespace }} get ingress

echo
echo "==> install complete."
echo "    Reach the app at the ingress host (add an /etc/hosts entry"
echo "    pointing fullstack-app.local to your k3s node IP if needed)."
